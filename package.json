{
  "name": "claude-country-club",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, local mini golf companion for coding-agent waits",
  "author": "Claude Country Club",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:native": "cd native/ccc-hook && go test ./...",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:courses": "node scripts/test-courses.mjs",
    "test:full-round": "node scripts/test-full-round.mjs",
    "test:gestures": "node scripts/test-gestures.mjs",
    "test:pointer-interruption": "node scripts/test-pointer-interruption.mjs",
    "test:startup-drag": "node scripts/test-startup-drag.mjs",
    "test:input-provenance": "node scripts/test-input-provenance.mjs",
    "test:input-conflicts": "node scripts/test-input-conflicts.mjs",
    "test:focus-interruption": "node scripts/probe-focus-interruption.mjs",
    "test:client-discovery-repeat": "node scripts/test-client-discovery-repeat.mjs",
    "verify:mac-helper-crossbuild": "node scripts/verify-mac-helper-crossbuild.mjs",
    "test:helper-faults": "node scripts/test-helper-faults.mjs",
    "test:helper-build-info": "node scripts/test-helper-build-info.mjs",
    "test:consoleless-helper": "node scripts/test-consoleless-helper.mjs",
    "test:windows-hook-shells": "node scripts/probe-windows-hook-shells.mjs",
    "test:broker-crash": "node scripts/test-broker-crash.mjs",
    "test:parked-lifecycle": "node scripts/test-parked-lifecycle.mjs",
    "test:background-startup": "node scripts/test-background-startup.mjs",
    "test:lazy-protocol": "node scripts/test-lazy-protocol.mjs",
    "test:startup-ordering": "node scripts/test-startup-ordering-suite.mjs",
    "test:system-lifecycle": "node scripts/test-system-lifecycle.mjs",
    "test:claude-lifecycle": "node scripts/test-claude-lifecycle.mjs",
    "test:attention-delivery": "node scripts/test-attention-delivery.mjs",
    "test:display-bounds": "node scripts/test-display-bounds.mjs",
    "test:history-retention": "node scripts/test-history-retention.mjs",
    "test:private-identity": "node scripts/test-private-identity.mjs",
    "test:private-preview": "node scripts/test-private-preview.mjs",
    "test:client-discovery": "node scripts/test-client-discovery.mjs",
    "test:progress-files": "node scripts/test-progress-files.mjs",
    "test:diagnostics-export": "node scripts/test-diagnostics-export.mjs",
    "test:diagnostic-log": "node scripts/test-diagnostic-log.mjs",
    "test:installer": "node scripts/test-installer.mjs",
    "test:installer-interruption": "node scripts/test-installer-interruption.mjs",
    "test:installer-handoff": "node scripts/test-installer-handoff.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:save-faults": "node scripts/test-save-faults.mjs",
    "test:midflight-crash": "node scripts/test-midflight-crash.mjs",
    "test:corrupt-startup": "node scripts/test-corrupt-startup.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "measure:resources": "node scripts/measure-resources.mjs",
    "measure:owned-processes": "node scripts/measure-owned-processes.mjs",
    "measure:split-processes": "node scripts/measure-split-processes.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:mac": "npm run build && electron-builder --mac pkg --publish never",
    "verify": "npm run typecheck && npm test && npm run test:native"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
